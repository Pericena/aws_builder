# Copia este archivo como .env y ajusta la cuenta/región autorizadas.
# No agregues claves AWS, tokens, contraseñas ni contenido/rutas de claves PEM.
AWS_REGION=us-east-2
AWS_EXPECTED_ACCOUNT_ID=000000000000
# En EC2 déjalo vacío para usar el IAM instance profile.
# En un equipo local escribe el nombre de un perfil AWS ya configurado.
AWS_PROFILE=
